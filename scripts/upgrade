#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================


source /usr/share/yunohost/helpers

#=================================================
# ENSURE DOWNWARD COMPATIBILITY
#=================================================
ynh_script_progression "Ensuring downward compatibility..."

# from 2.13~ynh1, we don't use YNH built-in settings system but bind everything to the app's config.js file. Let's clean old settings. 
if ynh_app_upgrading_from_version_before_or_equal_to 2.12~ynh1; then
	settings_to_clean=( archivesPaths lang theme sortAsc pageSize combinePanels defaultPanel defaultPanels simplifyPostDisplay simplifyPostsDisplay showActorJson showPostsJson )
	for camel_case_setting_key in "${settings_to_clean[@]}"
	do
		snake_case_setting_key="$(echo $camel_case_setting_key | sed 's/\([a-z0-9]\)\([A-Z]\)/\1_\L\2/g')" #changes 'myVar' into 'my_var'
		ynh_app_setting_delete --key=$camel_case_setting_key
		ynh_app_setting_delete --key=$snake_case_setting_key
	done
fi

# Set default values for new settings if any  
# Since v2.8~ynh1
archives_paths=${archives_paths:-""}
lang=${lang:-"\"auto\""}
theme=${theme:-"\"auto\""}
sort_asc=${sort_asc:-true}
page_size=${page_size:-10}
combine_panels=${combine_panels:-false}
default_panel=${default_panel:-"\"actor\""}
simplify_posts_display=${simplify_posts_display:-false}
# Since v2.9~ynh1 
show_actor_json=${show_actor_json:-false}
show_posts_json=${show_posts_json:-false}
# Since v2.13~ynh1
images_compact_layout=${images_compact_layout:-false}
hide_no_alt_text_notice=${hide_no_alt_text_notice:-false}
app_title=${app_title:-"\"MARL - Mastodon Archive Reader Lite\""}
loop_gifs=${loop_gifs:-true}

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Upgrading source files..."

ynh_safe_rm $install_dir
mkdir -p $install_dir

temp_dir=$(mktemp -d)
ynh_setup_source --dest_dir="$temp_dir"
mv $temp_dir/dist/* $install_dir #keep only the content of `dist` folder
ynh_safe_rm $temp_dir

#=================================================
# UPDATE A CONFIG FILE
#=================================================
ynh_script_progression "Adding $app's configuration files..."

ynh_config_add --template="config.js" --destination="$install_dir/js/config.js"

# FIXME: this should be handled by the core in the future
chmod 644 "$install_dir/js/config.js"
chown "$app:$app" "$install_dir/js/config.js"

#=================================================
# REAPPLY SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Upgrading system configurations related to $app..."

ynh_config_add_nginx

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
