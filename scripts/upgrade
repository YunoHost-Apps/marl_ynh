#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================


source /usr/share/yunohost/helpers

#=================================================
# ENSURE DOWNWARD COMPATIBILITY
#=================================================
ynh_script_progression "Ensuring downward compatibility..."

# Since v2.8~ynh1
ynh_app_setting_set_default --key=archivesPaths --value=""
ynh_app_setting_set_default --key=lang --value="en"
ynh_app_setting_set_default --key=theme --value="light"
ynh_app_setting_set_default --key=sortAsc --value=true
ynh_app_setting_set_default --key=pageSize --value=10
ynh_app_setting_set_default --key=combinePanels --value=false
ynh_app_setting_set_default --key=defaultPanels --value=null
ynh_app_setting_set_default --key=simplifyPostDisplay --value=false
# Since v2.9~ynh1 
ynh_app_setting_set_default --key=showActorJson --value=false
ynh_app_setting_set_default --key=showPostsJson --value=false
# Since v2.13~ynh1
ynh_app_setting_set_default --key=imagesCompactLayout --value=false
ynh_app_setting_set_default --key=hideNoAltTextNotice --value=false
ynh_app_setting_set_default --key=appTitle --value="MARL - Mastodon Archive Reader Lite"
ynh_app_setting_set_default --key=loopGifs --value=true

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Upgrading source files..."

ynh_safe_rm $install_dir
mkdir -p $install_dir

temp_dir=$(mktemp -d)
ynh_setup_source --dest_dir="$temp_dir"
mv $temp_dir/dist/* $install_dir #keep only the content of `dist` folder
ynh_safe_rm $temp_dir

#=================================================
# UPDATE A CONFIG FILE
#=================================================
ynh_script_progression "Adding $app's configuration files..."

ynh_config_add --template="config.js" --destination="$install_dir/js/config.js"

# FIXME: this should be handled by the core in the future
chmod 644 "$install_dir/js/config.js"
chown "$app:$app" "$install_dir/js/config.js"

#=================================================
# REAPPLY SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Upgrading system configurations related to $app..."

ynh_config_add_nginx

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
